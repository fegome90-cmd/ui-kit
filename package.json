{
  "name": "ui-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e": "playwright test",
    "predev": "node scripts/gen-sources.mjs && npm run -s registry",
    "prebuild": "node scripts/gen-sources.mjs && npm run -s registry",
    "pretypecheck": "node scripts/gen-sources.mjs",
    "ci": "bash scripts/ci.sh",
    "prepare": "lefthook install || true",
    "registry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-registry.mjs && shadcn build"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.2.6",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.2.6",
    "@fontsource-variable/playfair-display": "^5.2.6",
    "@fontsource/abril-fatface": "^5.2.6",
    "@fontsource/archivo-black": "^5.2.6",
    "@fontsource/bebas-neue": "^5.2.5",
    "@fontsource/dm-serif-display": "^5.2.6",
    "@fontsource/rubik-mono-one": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "postcss": "^8.5.6",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
